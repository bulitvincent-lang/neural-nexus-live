{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neural Orb",
  "version": "0.1.0",
  "identifier": "app.neuralorb.desktop",
  "build": {
    "frontendDist": "../dist/desktop",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "label": "orb",
        "width": 420,
        "height": 420,
        "minWidth": 120,
        "minHeight": 120,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "x": 80,
        "y": 80,
        "dragDropEnabled": false,
        "url": "index.html"
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
